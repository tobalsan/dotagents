{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-evaluation-result-v1.schema.json",
  "title": "Deep research campaign evaluation result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "target"],
      "properties": {
        "outcome": {"enum": ["continue", "complete"]},
        "target": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason", "limit"],
      "properties": {
        "outcome": {"const": "failed"},
        "reason": {"const": "operational_limit_exceeded"},
        "limit": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason", "error"],
      "properties": {
        "outcome": {"const": "failed"},
        "reason": {"const": "state_error"},
        "error": {"type": "string", "minLength": 1}
      }
    }
  ]
}
