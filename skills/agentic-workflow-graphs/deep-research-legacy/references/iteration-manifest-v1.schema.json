{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iteration-manifest-v1.schema.json",
  "title": "Iteration manifest v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "iteration_id",
    "node_id",
    "node_kind",
    "state",
    "attempt",
    "observed_at",
    "dependencies"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "iteration_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "node_kind": {
      "type": "string",
      "enum": ["iteration", "scope", "plan", "researcher", "extract", "skeptic", "merge", "persist", "synthesize"]
    },
    "state": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "retrying", "saturated"]
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "harness": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "thinking": { "type": "string", "minLength": 1 },
    "routing_rationale": { "type": "string", "minLength": 1 },
    "routing_policy_ref": { "type": "string", "minLength": 1 },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "retry_decision": {
      "type": "string",
      "enum": ["retry", "do_not_retry"]
    },
    "retry_reason": { "type": "string", "minLength": 1 },
    "terminal_outcome": {
      "type": "string",
      "enum": ["completed", "saturated", "failed"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": { "required": ["error", "retry_decision"] }
    },
    {
      "if": { "properties": { "retry_decision": { "const": "retry" } }, "required": ["retry_decision"] },
      "then": { "required": ["retry_reason"] }
    },
    {
      "if": { "properties": { "node_kind": { "const": "iteration" } }, "required": ["node_kind"] },
      "then": {
        "if": {
          "properties": {
            "state": { "enum": ["completed", "saturated", "failed"] }
          },
          "required": ["state"]
        },
        "then": {
          "required": ["terminal_outcome", "artifact_paths"],
          "properties": {
            "artifact_paths": {
              "type": "object",
              "required": ["gap_report"],
              "additionalProperties": { "type": "string", "minLength": 1 },
              "properties": {
                "gap_report": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  ]
}
